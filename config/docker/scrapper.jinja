{% from 'config/docker/macros.jinja' import redis_configuration, common, domain_image, storage, config_env with context %}

scrapper:
    {{ domain_image('scrapper', SCRAPPER)|indent(8) }}
    container_name: scrapper
    {{ config_env() }}
    restart: always
    depends_on:
        - mysql
        - redis
        - wdb
        - chromedriver
    ports:
        - 8000:8000
    command: python scrapper/run.py
    networks:
        default_net:
