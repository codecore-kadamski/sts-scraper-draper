{% from 'config/docker/macros.jinja' import redis_configuration, common, domain_image, storage, config_env with context %}

flower:
    {{ domain_image('scrapper', SCRAPPER)|indent(8) }}
    container_name: flower
    {{ config_env() }}
    restart: always
    ports:
        - "5555:5555"
    command: celery flower -A scrapper.scrapper --port=5555 --broker=redis://redis:6379/0 -l info
    networks:
        default_net:
            ipv4_address: 172.23.0.15
